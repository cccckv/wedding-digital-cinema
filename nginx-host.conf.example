# ==============================================================================
# Ubuntu 宿主机 Nginx 反向代理配置参考示例
# 文件路径建议：/etc/nginx/sites-available/wedding-cinema.conf
# 启用命令：sudo ln -s /etc/nginx/sites-available/wedding-cinema.conf /etc/nginx/sites-enabled/
# 重载配置：sudo nginx -t && sudo systemctl reload nginx
# ==============================================================================

# 1. HTTP 访问（若配置了域名可直接使用，或由 Certbot 自动配置证书）
server {
    listen 80;
    listen [::]:80;
    server_name your-domain.com www.your-domain.com; # 替换为您实际绑定的域名或服务器IP

    # 客户端上传限制（支持大文件/素材传输）
    client_max_body_size 100M;

    location / {
        proxy_pass http://127.0.0.1:8080; # 对应 docker-compose.yml 映射的端口
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket 支持
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # 超时设置
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}

